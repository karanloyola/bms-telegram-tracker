# Token from @BotFather for YOUR bot
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat IDs allowed to use the bot (send /myid to the bot to get yours).
# Leave blank only while setting up — blank means anyone who finds the bot can use it.
ALLOWED_CHAT_IDS=
# Row-level checking reads BookMyShow's seat map. Set to false for seat-class alerts only.
ENABLE_SEAT_MAP=true
